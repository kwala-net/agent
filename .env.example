# LLM provider — "custom" (default), "anthropic", or "gemini"
LLM_PROVIDER=custom

# Custom provider: endpoint that accepts a POST with the trading context payload
# and returns { action, token, amount_eth, confidence, reasoning }.
# Built-in options (no auth headers required by callers):
#   http://localhost:3000/api/llm    — momentum strategy (no API key needed)
#   http://localhost:3000/api/gemini — Gemini proxy (requires GEMINI_API_KEY)
CUSTOM_LLM_URL=http://localhost:3000/api/llm

# Anthropic provider (set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=

# Gemini provider (set LLM_PROVIDER=gemini to use, or set CUSTOM_LLM_URL to /api/gemini)
GEMINI_API_KEY=

# Ethereum Sepolia RPC
ETH_SEPOLIA_RPC_URL=

# Wallet — deploys TraderAgent contract and calls openTrade/emitSell/closeTrade.
# This is NOT the Kwala smart wallet; it's your own deployer EOA.
PRIVATE_KEY=

# Deployed TraderAgent contract address (from `npm run deploy:contract`)
TRADERAGENT_CONTRACT_ADDRESS=

# Kwala smart wallet address (from Kwala dashboard)
KWALA_SMART_WALLET=

# Server
PORT=3000
