# LLM provider — "custom" (default) or "anthropic"
LLM_PROVIDER=custom

# Custom provider (default): any HTTP endpoint that accepts a POST with the
# trading context payload and returns { action, token, amount_eth, confidence, reasoning }.
# No authentication headers are sent.
CUSTOM_LLM_URL=

# Anthropic provider (set LLM_PROVIDER=anthropic to use)
ANTHROPIC_API_KEY=

# Polygon RPC
POLYGON_RPC_URL=

# Wallet — deploys TraderAgent contract and calls openTrade/emitSell/closeTrade.
# This is NOT the Kwala smart wallet; it's your own deployer EOA.
PRIVATE_KEY=

# Deployed TraderAgent contract address (from `npm run deploy:contract`)
TRADERAGENT_CONTRACT_ADDRESS=

# Kwala smart wallet address (from Kwala dashboard)
KWALA_SMART_WALLET=

# Server
PORT=3000
